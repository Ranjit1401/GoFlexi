# Database Connection
DATABASE_URL=postgresql+psycopg://YOUR_NEON_CONNECTION_STRING

# JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]

# SerpApi Live Travel Search (Google Flights & Google Hotels)
# Sign up at https://serpapi.com to get your live API key
SERPAPI_API_KEY=your-serpapi-key

# Legacy Sky Scrapper Travel Search (RapidAPI - optional)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# OpenTripMap POI & Activities API (Optional - free tier key from opentripmap.com)
OPENTRIPMAP_API_KEY=your-opentripmap-key

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Indian Railway (IRCTC) RapidAPI (irctc1.p.rapidapi.com)
RAPIDAPI_RAILWAY_KEY=your-rapidapi-railway-key
RAPIDAPI_RAILWAY_HOST=irctc1.p.rapidapi.com

